<?xml version="1.0" encoding="utf-8"?>
<!--
    Màn hình Hồ sơ người dùng.
    - Avatar tròn, rộng 35% màn hình, tỉ lệ 1:1 (DimensionRatio + Width_percent).
    - 4 dòng "nhãn | giá trị": cột giá trị neo vào Barrier (Cấp 2) nên luôn
      nằm sau nhãn dài nhất ("Số điện thoại"), dù đổi ngôn ngữ hay cỡ chữ.
    - 2 nút chia đều bằng chain ngang + weight.
    - Bọc ScrollView để không bị cắt khi xoay ngang.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ProfileActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAvatar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:background="@color/avatar_bg"
            android:contentDescription="@string/avatar_desc"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_myplaces"
            app:contentPadding="20dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Lab2.Circle"
            app:tint="@color/vlu_red"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="200dp"
            app:layout_constraintWidth_percent="0.35" />

        <TextView
            android:id="@+id/tvFullName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/profile_name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgAvatar" />

        <TextView
            android:id="@+id/tvRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/profile_role"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFullName" />

        <!-- ===== Cột nhãn ===== -->
        <TextView
            android:id="@+id/tvLabelEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/label_email"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRole" />

        <TextView
            android:id="@+id/tvLabelMssv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_mssv"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvValueEmail" />

        <TextView
            android:id="@+id/tvLabelClass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_class"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvValueMssv" />

        <!-- Cấp 2: dòng "Số điện thoại" (nhãn dài nhất) -->
        <TextView
            android:id="@+id/tvLabelPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_phone"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvValueClass" />

        <!-- Cấp 2: Barrier tự dịch theo nhãn rộng nhất -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierLabels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="tvLabelEmail,tvLabelMssv,tvLabelClass,tvLabelPhone" />

        <!-- ===== Cột giá trị (neo vào Barrier, căn baseline với nhãn) ===== -->
        <TextView
            android:id="@+id/tvValueEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textSize="16sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabelEmail"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/barrierLabels"
            tools:text="sv01@vlu.edu.vn" />

        <TextView
            android:id="@+id/tvValueMssv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/value_mssv"
            android:textSize="16sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabelMssv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/barrierLabels" />

        <TextView
            android:id="@+id/tvValueClass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/value_class"
            android:textSize="16sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabelClass"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/barrierLabels" />

        <TextView
            android:id="@+id/tvValuePhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/value_phone"
            android:textSize="16sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabelPhone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/barrierLabels" />

        <!-- ===== Hai nút: chain ngang, chia đều ===== -->
        <Button
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_edit"
            app:layout_constraintEnd_toStartOf="@id/btnLogout"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvValuePhone" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_logout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btnEdit"
            app:layout_constraintTop_toTopOf="@id/btnEdit" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
